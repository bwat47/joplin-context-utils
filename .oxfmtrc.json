{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "endOfLine": "lf",
    "sortImports": {
        "customGroups": [{ "groupName": "joplin", "elementNamePattern": ["api", "api/**"] }],
        "groups": [
            ["value-builtin", "type-builtin"],
            ["value-external", "type-external"],
            { "newlinesBetween": true },
            "joplin",
            ["value-parent", "type-parent", "value-sibling", "type-sibling", "value-index", "type-index"],
            "unknown"
        ],
        "newlinesBetween": false,
        "sortSideEffects": false
    },
    "sortPackageJson": false,
    "ignorePatterns": ["api/", ".api-staging-*/", "package-lock.json"]
}

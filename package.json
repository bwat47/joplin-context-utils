{
    "name": "joplin-plugin-context-utils",
    "version": "1.10.0",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "oxlint src/ && npm run lint:dead-code && npm run lint:complexity",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity",
        "lint:fix": "oxlint src/ --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest --passWithNoTests",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.5.0",
        "@codemirror/lang-markdown": "6.5.0",
        "@codemirror/language": "6.12.3",
        "@codemirror/state": "6.7.1",
        "@codemirror/view": "6.43.14",
        "@lezer/common": "1.5.0",
        "@lezer/markdown": "1.6.3",
        "@types/node": "^24.13.2",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint-plugin-regexp": "^3.3.3",
        "fallow": "^3.43.0",
        "jsdom": "^31.0.0",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "@joplin/fork-uslug": "^2.0.6",
        "entities": "^9.0.0"
    }
}

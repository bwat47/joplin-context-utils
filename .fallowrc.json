{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": [
        "src/index.ts",
        "src/contentScripts/editor/contentScript.ts",
        "src/contentScripts/viewer/viewerContentScript.ts",
        "src/contentScripts/viewer/viewerContextMenu.js",
        "src/resourceProperties/webview/resourcePropertiesDialog.js",
        "src/resourceProperties/webview/resourcePropertiesDialog.css"
    ],
    "supportEntry": ["src/**/*.test.ts"],
    "ignorePatterns": ["**/*.d.ts", "api/**"],
    "rules": {
        "complexity-crap": "off",
        "dev-dependencies-in-production": "off"
    },
    "health": {
        "maxCognitive": 15,
        "maxCyclomatic": 20
    }
}
